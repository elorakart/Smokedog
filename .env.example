# Leave empty locally so the client uses the same origin (unified server.ts).
# On Vercel, set to the active game server origin.
NEXT_PUBLIC_SOCKET_URL=

# --- Backup (Railway) — use for instant rollback on Vercel ---
# NEXT_PUBLIC_SOCKET_URL=https://game-production-22ef.up.railway.app

# --- Cloudflare (OpenNext UI + DO game server) ---
# UI: npm run deploy:cf
# Game: npm run deploy:cf:game
# NEXT_PUBLIC_SOCKET_URL=https://smokedog-game.<subdomain>.workers.dev

# --- Future (Oracle Cloud) — after migration cutover ---
# NEXT_PUBLIC_SOCKET_URL=https://your-oracle-host-or-domain

# Production game server process
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Production CORS (game server must allow the Vercel UI origin):
# CORS_ORIGIN=https://smokedog.vercel.app

# Allow multiple frontends (comma-separated), e.g. Vercel + Cloudflare:
# CORS_ORIGIN=https://smokedog.vercel.app,https://smokedog.<account>.workers.dev
