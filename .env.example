# Leave empty locally so the client uses the same origin (unified server.ts).
NEXT_PUBLIC_SOCKET_URL=

# Cloudflare production (set in wrangler.jsonc, not .env):
# NEXT_PUBLIC_SOCKET_URL=https://smokedog-game.<subdomain>.workers.dev
# UI: npm run deploy:cf
# Game: npm run deploy:cf:game

# Local split-mode testing (game server in a second terminal):
# NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Standalone game server process (local or self-hosted VM only)
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Self-hosted game server CORS (comma-separated origins allowed):
# CORS_ORIGIN=https://smokedog.<subdomain>.workers.dev
